<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundleDisplayName</key>
	<string>Retro-3DO</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
	<key>CFBundleVersion</key>
	<string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- 16.0, not 15.0: the SwiftUI front end uses NavigationStack,
	     LabeledContent and persistentSystemOverlays, all of which are
	     iOS 16. That is iPhone 8 and later. -->
	<key>MinimumOSVersion</key>
	<string>16.0</string>

	<!-- Declared here so no upload stops to ask. Without this key App Store
	     Connect raises the export-compliance question on every delivery and
	     holds the build out of TestFlight until someone answers it by hand.
	     False is the accurate answer: the emulator uses no encryption of its
	     own, and HTTPS through the system libraries is exempt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- There are no purpose strings here any more, and their absence is the
	     point. They existed because SDL linked AVCaptureSession, AVCaptureDevice,
	     CBCentralManager and CMMotionManager whether or not the app ever called
	     them, and iOS demands a description for an API that is merely linked.
	     The iOS build no longer compiles SDL at all: the Swift front end links
	     UIKit, SwiftUI, Metal, MetalKit, CoreImage and AVFoundation, none of
	     which drags in a camera, a microphone, Bluetooth or the motion sensors.
	     Four permission descriptions that promised the app does not use the
	     camera are four fewer things on the App Store privacy page.

	     The CI job still derives the required list from the built binary rather
	     than trusting this comment, which is what would catch it if a future
	     framework brought one of those APIs back. -->

	<!-- A launch screen has to be declared, but naming a storyboard would pull
	     in ibtool, which only exists on macOS. An empty dictionary satisfies
	     iOS without adding that dependency. -->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- Kept, but no longer the way content arrives. The app imports through
	     iOS's own document picker now, so a person never has to find the Files
	     app at all; these two remain so that someone who already keeps their
	     discs in the app's folder is not cut off, and so a file can be opened
	     into the app from elsewhere. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Landscape only. The machine's picture is 4:3 and the on-screen pad
	     sits either side of it; in portrait the picture shrinks to a band and
	     the controls have nowhere to go. The shelf is laid out for the same
	     orientation so that starting a game never rotates the device under
	     the player. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIRequiresFullScreen</key>
	<true/>
</dict>
</plist>
