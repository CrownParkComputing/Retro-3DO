<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundleDisplayName</key>
	<string>Spryte</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
	<key>CFBundleVersion</key>
	<string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- 16.0, not 15.0: the SwiftUI front end uses NavigationStack,
	     LabeledContent and persistentSystemOverlays, all of which are
	     iOS 16. That is iPhone 8 and later. -->
	<key>MinimumOSVersion</key>
	<string>16.0</string>

	<!-- Declared here so no upload stops to ask. Without this key App Store
	     Connect raises the export-compliance question on every delivery and
	     holds the build out of TestFlight until someone answers it by hand.
	     False is the accurate answer: the emulator uses no encryption of its
	     own, and HTTPS through the system libraries is exempt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Required, and not by SDL. Sound.swift sets an AVAudioSession category
	     so the emulator's audio mixes with whatever the person is already
	     playing, and iOS demands this description from any binary that links
	     AVAudioSession at all, called or not. Without it the upload is accepted
	     and then discarded in processing as ITMS-90683, hours later, by email.
	     The wording is the truth: the app plays sound and never records. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Spryte does not record audio and has no microphone feature. This entry is required because the app configures an audio session in order to play the emulated console's sound, and iOS asks for a description whenever that system is used.</string>

	<!-- The camera, motion and Bluetooth strings that used to sit here are gone
	     with SDL, which linked AVCaptureSession, AVCaptureDevice,
	     CBCentralManager and CMMotionManager whether or not the app ever called
	     them. The Swift front end links none of those, and the pre-flight check
	     reads the built binary rather than this comment, and it is what
	     proved the three were genuinely gone and the one above was not. Three
	     permission prompts the app never needed are three fewer things on its
	     App Store privacy page. -->

	<!-- A launch screen has to be declared, but naming a storyboard would pull
	     in ibtool, which only exists on macOS. An empty dictionary satisfies
	     iOS without adding that dependency. -->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- Kept, but no longer the way content arrives. The app imports through
	     iOS's own document picker now, so a person never has to find the Files
	     app at all; these two remain so that someone who already keeps their
	     discs in the app's folder is not cut off, and so a file can be opened
	     into the app from elsewhere. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- iPhone stays landscape: the machine's picture is 4:3 and the on-screen
	     pad sits either side of it, so in portrait the picture shrinks to a band
	     and the controls have nowhere to go.

	     iPad takes all four. It is not a preference — an iPad app that refuses
	     orientations is handed a compatibility window, and the shelf came up
	     running upright in a 2064x1546 band of a 2064x2752 screen with most of
	     the display black. The session lays its controls under the picture when
	     the window is taller than it is wide. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIStatusBarHidden</key>
	<true/>
</dict>
</plist>
